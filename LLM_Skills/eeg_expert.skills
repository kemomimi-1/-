# --- simulate_new_eeg_data.skills ---

# --- eeg_route_a_neurora.skills ---

def run_analyze(target_table=None, *args, **kwargs):
    """
    EEG 高精度自适应诊断引擎 V9 — 全库自动扫描版
    ==============================================
    自动扫描 InfluxDB (eeg_db) 中所有表，检测哪些包含可分析的 EEG 数据，
    动态构建特征空间，使用 XGBoost 个体专属模型 Subject-Dependent 5-Fold 交叉验证。
    使用方法:
      python eeg_high_accuracy_analyzer.py                       # 自动扫描所有表
      python eeg_high_accuracy_analyzer.py --table external_eeg  # 仅分析指定表
    """
    warnings.filterwarnings('ignore')
    AUTO_ANALYZE_ROW_LIMIT = 50000
    INFLUX_HOST, INFLUX_DB, INFLUX_TOKEN = "http://localhost:8181", "eeg_db", "apiv3_token"
    EEG_KEYWORDS = {'delta','theta','alpha','alpha1','alpha2','beta','beta1','beta2',
                    'gamma','gamma1','gamma2','attention','mediation','meditation'}
    def log(msg): print(msg, flush=True)
    def detect_col(cols, candidates, default=None):
        cl = list(cols.columns) if hasattr(cols, 'columns') else list(cols)
        for c in candidates:
            if c in cl: return c
        return default
    def discover_tables(client):
        log("  [扫描] 正在检索 InfluxDB 中所有可用数据表...")
        try:
            tdf = client.query("SHOW TABLES").to_pandas()
            nc = detect_col(tdf, ['table_name','name','Table','table'])
            if not nc: return []
            tables = tdf[nc].tolist()
        except Exception as e:
            log(f"  ⚠ SHOW TABLES 失败: {e}"); return []
        log(f"  [扫描] 发现 {len(tables)} 张表: {tables}")
        result = []
        for t in tables:
            try:
                cdf = client.query(f'SELECT COUNT(*) FROM "{t}"').to_pandas()
                rows = int(cdf.iloc[0,0]) if len(cdf)>0 else 0
                sdf = client.query(f'SELECT * FROM "{t}" LIMIT 1').to_pandas()
                hits = len(EEG_KEYWORDS & {c.lower() for c in sdf.columns})
                if hits >= 2 and rows > 0:
                    result.append((t, rows, hits))
                    log(f"    ✓ {t:20s} | {rows:>8,} 行 | {hits} 个EEG频段列")
                else:
                    log(f"    ✗ {t:20s} | {rows:>8,} 行 | {hits} 个频段列 (跳过)")
            except: continue
        return result
    def select_tables(analyzable):
        total = sum(r for _,r,_ in analyzable)
        log(f"\n  [决策] 发现 {len(analyzable)} 张可分析表，总计 {total:,} 行数据")
        log("  " + "-"*50)
        for i,(t,r,h) in enumerate(analyzable):
            log(f"    [{i+1}] {t} ({r:,} 行, {h} 个频段)")
        log(f"    [0] 全部分析 (共 {total:,} 行，可能较慢)")
        log("  " + "-"*50)
        try: choice = input("  请输入编号 (多个用逗号分隔，如 1,2。直接回车默认分析第一张表): ").strip()
        except EOFError: choice = '1'
        if choice == '0': return [t[0] for t in analyzable]
        if choice == '': return [analyzable[0][0]]
        sel = []
        for p in choice.split(','):
            p = p.strip()
            try:
                idx = int(p)-1
                if 0 <= idx < len(analyzable): sel.append(analyzable[idx][0])
            except:
                if p in [t[0] for t in analyzable]: sel.append(p)
        return sel if sel else [analyzable[0][0]]
    def parse_id(val, prefix):
        s = str(val).strip()
        if s.upper().startswith(prefix.upper()):
            try: return int(float(s[len(prefix):]))
            except: return -1
        try: return int(float(s))
        except: return -1
    def parse_label(val):
        s = str(val).strip().lower()
        if s in ('yes','1','1.0','true','confused','high','positive'): return 1
        if s in ('no','0','0.0','false','not confused','low','negative','focused'): return 0
        try: return 1 if float(s)>0.5 else 0
        except: return 0
    def analyze_table(client, table_name):
        """对单张表执行完整的特征工程 + XGBoost 5-Fold 验证，返回报告字典"""
        log(f"  [1/4] 数据加载: 从 '{table_name}' 获取数据...")
        try: df = client.query(f'SELECT * FROM "{table_name}" ORDER BY subject_id, video_id, time').to_pandas()
        except: df = client.query(f'SELECT * FROM "{table_name}"').to_pandas()
        log(f"  >>> 原始拉取: {len(df)} 行, 列名: {list(df.columns)}")
        # ---- 列检测 ----
        log("  [2/4] 自适应列检测...")
        sub_col = detect_col(df, ['subject_id','SubjectID','subject','sub','participant','user_id'])
        vid_col = detect_col(df, ['video_id','VideoID','video','vid','trial','session'])
        label_col = detect_col(df, ['self_confused','confused','label','Label','class','target','state','cognitive_state'])
        if not sub_col: df['subject_id']='S0'; sub_col='subject_id'
        if not vid_col: df['video_id']='V0'; vid_col='video_id'
        if not label_col:
            log("  ✗ 未检测到标签列，跳过此表"); return None
        df['sub'] = df[sub_col].apply(lambda x: parse_id(x,'S'))
        df['vid'] = df[vid_col].apply(lambda x: parse_id(x,'V'))
        df['label'] = df[label_col].apply(parse_label)
        df = df[df['sub']>=0].copy().sort_values(['sub','vid','time']).reset_index(drop=True)
        log(f"  >>> 有效数据: {len(df)} 行, {df['sub'].nunique()} 位被试")
        # ---- 自适应特征工程 ----
        log("  [3/4] 自适应特征工程...")
        eps = 1e-6
        band_map = {'delta':['delta','Delta'],'theta':['theta','Theta'],
                    'alpha1':['alpha1','Alpha1','lowAlpha','low_alpha'],
                    'alpha2':['alpha2','Alpha2','highAlpha','high_alpha'],
                    'beta1':['beta1','Beta1','lowBeta','low_beta'],
                    'beta2':['beta2','Beta2','highBeta','high_beta'],
                    'gamma1':['gamma1','Gamma1','lowGamma','low_gamma'],
                    'gamma2':['gamma2','Gamma2','highGamma','high_gamma'],
                    'attention':['attention','Attention','att'],
                    'mediation':['mediation','Mediation','meditation','Meditation']}
        available = []
        for std, aliases in band_map.items():
            f = detect_col(df, aliases)
            if f:
                if f != std: df[std] = df[f]
                available.append(std)
        # 宽频带拆分
        for pair, single_keys in [(['alpha1','alpha2'],['alpha','Alpha']),
                                   (['beta1','beta2'],['beta','Beta']),
                                   (['gamma1','gamma2'],['gamma','Gamma'])]:
            if pair[0] not in available and pair[1] not in available:
                f = detect_col(df, single_keys)
                if f:
                    df[pair[0]] = df[f]*0.5; df[pair[1]] = df[f]*0.5
                    available.extend(pair)
        log(f"  >>> 基础频段: {available}")
        # 合成宽频带 + 认知比值
        derived, cognitive = [], []
        for name, p1, p2 in [('alpha_total','alpha1','alpha2'),('beta_total','beta1','beta2'),('gamma_total','gamma1','gamma2')]:
            if p1 in available and p2 in available:
                df[name] = df[p1]+df[p2]; derived.append(name)
        if 'theta' in available and 'beta_total' in derived:
            df['theta_beta'] = df['theta']/(df['beta_total']+eps); cognitive.append('theta_beta')
        if 'theta' in available and 'alpha_total' in derived:
            df['theta_alpha'] = df['theta']/(df['alpha_total']+eps); cognitive.append('theta_alpha')
        if 'alpha_total' in derived and 'beta_total' in derived:
            df['alpha_beta'] = df['alpha_total']/(df['beta_total']+eps); cognitive.append('alpha_beta')
        # [优化1] Engagement 使用 beta_total 而非仅 beta1 (知识库 4.2: Engagement 是最可靠指标 -19.6%)
        if 'beta_total' in derived and 'alpha_total' in derived and 'theta' in available:
            df['engagement'] = df['beta_total']/(df['alpha_total']+df['theta']+eps); cognitive.append('engagement')
        if 'theta' in available and 'alpha_total' in derived and 'beta_total' in derived:
            df['fatigue'] = (df['theta']+df['alpha_total'])/(df['beta_total']+eps); cognitive.append('fatigue')
        if 'beta_total' in derived and 'delta' in available and 'theta' in available:
            df['focus'] = df['beta_total']/(df['delta']+df['theta']+eps); cognitive.append('focus')
        # [优化2] 相对功率特征 — 消除"同涨陷阱" (知识库 3.4: 所有频段绝对PSD同向上升, 比值才有区分力)
        rel_feats = []
        raw_bands = [b for b in ['delta','theta','alpha1','alpha2','beta1','beta2','gamma1','gamma2'] if b in available]
        if len(raw_bands) >= 4:
            df['total_power'] = sum(df[b] for b in raw_bands) + eps
            for b in raw_bands:
                rname = b + '_rel'
                df[rname] = df[b] / df['total_power']
                rel_feats.append(rname)
            log(f"  >>> 相对功率特征: {len(rel_feats)} 维 (消除同涨陷阱)")
        core = available + cognitive + rel_feats
        group = df.groupby(['sub','vid'])
        for c in core: df[c+'_d1'] = group[c].diff().fillna(0)
        for c in core: df[c+'_d2'] = group[c+'_d1'].diff().fillna(0)
        for c in core:
            df[c+'_m3'] = group[c].rolling(3,min_periods=1).mean().reset_index([0,1],drop=True)
            df[c+'_s3'] = group[c].rolling(3,min_periods=1).std().fillna(0).reset_index([0,1],drop=True)
        for c in core:
            df[c+'_m5'] = group[c].rolling(5,min_periods=1).mean().reset_index([0,1],drop=True)
            df[c+'_s5'] = group[c].rolling(5,min_periods=1).std().fillna(0).reset_index([0,1],drop=True)
        # [V9.2 优化4] 大窗口 W=7 滑动特征 — 捕捉约3.5秒长程认知趋势
        for c in core:
            df[c+'_m7'] = group[c].rolling(7,min_periods=1).mean().reset_index([0,1],drop=True)
            df[c+'_s7'] = group[c].rolling(7,min_periods=1).std().fillna(0).reset_index([0,1],drop=True)
        # [优化3] 变异系数 CV = std/mean (知识库 3.5)
        cv_feats = []
        for c in core:
            cv3 = c + '_cv3'
            df[cv3] = df[c+'_s3'] / (df[c+'_m3'].abs() + eps)
            cv_feats.append(cv3)
        log(f"  >>> 变异系数特征: {len(cv_feats)} 维 (归一化波动率)")
        feats = core+[c+'_d1' for c in core]+[c+'_d2' for c in core]+[c+'_m3' for c in core]+[c+'_s3' for c in core]+[c+'_m5' for c in core]+[c+'_s5' for c in core]+[c+'_m7' for c in core]+[c+'_s7' for c in core]+cv_feats
        dims = len(feats)
        log(f"  >>> 特征空间: {dims} 维 (核心 {len(core)} x 9 + CV {len(cv_feats)})")
        # ---- XGBoost 5-Fold ----
        log("  [4/4] XGBoost Subject-Dependent 5-Fold 交叉验证...")
        # [V9.2 优化5] XGBoost 正则化 — 抑制高维特征噪声, 防止强势被试过拟合
        xgb_params = dict(
            n_estimators=500, max_depth=7, learning_rate=0.05,
            subsample=0.8, colsample_bytree=0.7, min_child_weight=3,
            reg_alpha=0.1, reg_lambda=1.5,
            eval_metric='logloss', random_state=42
        )
        try:
            model = xgb.XGBClassifier(**xgb_params, tree_method='hist', device='cuda')
            log("  >>> GPU 加速 (CUDA) | 500树 depth=7 正则化")
        except:
            model = xgb.XGBClassifier(**xgb_params, n_jobs=-1)
            log("  >>> CPU 并行 | 500树 depth=7 正则化")
        subject_accs, total_correct, total_samples = [], 0, 0
        for sub in sorted(df['sub'].unique()):
            X = np.nan_to_num(df.loc[df['sub']==sub, feats].values.astype(float))
            y = df.loc[df['sub']==sub, 'label'].values
            if len(np.unique(y))<2 or len(y)<10: continue
            kf = StratifiedKFold(n_splits=5,shuffle=True,random_state=42)
            fold_accs = []
            for tri, tei in kf.split(X,y):
                mu, sd = np.mean(X[tri],0), np.std(X[tri],0); sd[sd==0]=1e-6
                Xtr, Xte = (X[tri]-mu)/sd, (X[tei]-mu)/sd
                model.fit(Xtr, y[tri]); pred = model.predict(Xte)
                fold_accs.append(accuracy_score(y[tei],pred)*100)
                total_correct += np.sum(pred==y[tei]); total_samples += len(y[tei])
            sa = np.mean(fold_accs); subject_accs.append(sa)
            log(f"  - 被试 S{sub} 平均验证准确率: {sa:.2f}%")
        if not subject_accs:
            log("  ✗ 无有效被试"); return None
        acc = np.mean(subject_accs)
        report = {'table':table_name,'samples':total_samples,'subjects':len(subject_accs),
                  'dims':dims,'bands':available,'cognitive':cognitive,'accuracy':acc}
        log(f"\n  {'='*60}")
        log(f"  [{table_name}] 性能评估报告")
        log(f"  {'='*60}")
        log(f"  - 数据总量: {total_samples} 帧 | 被试数: {len(subject_accs)}")
        log(f"  - 特征维度: {dims} 维 | 频段: {available}")
        log(f"  - 认知比值: {cognitive}")
        log(f"  - 模型: XGBoost (300 trees, depth=8)")
        log(f"  {'-'*40}")
        log(f"  > 平均准确率: {acc:.2f}% <")
        log(f"  {'-'*40}")
        return report
    # ============================================================
    #  主入口
    # ============================================================
    log("="*70)
    log("  EEG 认知状态高精度分类验证模块 (Subject-Dependent Analysis)")
    log("  自适应多数据源引擎 V9 — 全库自动扫描版")
    log("="*70)
    client = InfluxDBClient3(host=INFLUX_HOST, database=INFLUX_DB, token=INFLUX_TOKEN, org="")
    if target_table:
        tables = [target_table]
        log(f"  [模式] 指定表: {tables[0]}")
    elif '--table' in sys.argv:
        idx = sys.argv.index('--table')
        tables = [sys.argv[idx+1]] if idx+1<len(sys.argv) else ['kaggle_eeg']
        log(f"  [模式] 指定表: {tables[0]}")
    else:
        log("  [模式] 全库自动扫描")
        found = discover_tables(client)
        if not found: log("  ✗ 未发现可分析的EEG表！"); sys.exit(1)
        tables = select_tables(found)
    log(f"\n  将分析 {len(tables)} 张表: {tables}\n")
    reports = []
    for i, t in enumerate(tables):
        if len(tables) > 1:
            log(f"\n{'━'*70}")
            log(f"  ▶ [{i+1}/{len(tables)}] {t}")
            log(f"{'━'*70}")
        r = analyze_table(client, t)
        if r: reports.append(r)
    # ---- 汇总报告 ----
    if len(reports) > 1:
        log(f"\n\n{'═'*70}")
        log("  全库 EEG 分析汇总报告")
        log(f"{'═'*70}")
        log(f"  {'表名':20s} | {'被试':>4s} | {'样本':>8s} | {'维度':>4s} | {'准确率':>8s}")
        log(f"  {'-'*20}-+-{'-'*4}-+-{'-'*8}-+-{'-'*4}-+-{'-'*8}")
        for r in reports:
            log(f"  {r['table']:20s} | {r['subjects']:>4d} | {r['samples']:>8,} | {r['dims']:>4d} | {r['accuracy']:>7.2f}%")
        overall = np.mean([r['accuracy'] for r in reports])
        log(f"  {'-'*20}-+-{'-'*4}-+-{'-'*8}-+-{'-'*4}-+-{'-'*8}")
        log(f"  {'全局平均':20s} |      |          |      | {overall:>7.2f}%")
        log(f"{'═'*70}")
    elif len(reports) == 1:
        log("\n" + "="*70)


def run_import(*args, **kwargs):
        main()


def run_inspect(target_table=None, *args, **kwargs):
    pd.set_option('display.width', 180)
    pd.set_option('display.max_columns', 20)
    client = InfluxDBClient3(host=INFLUX_HOST, database=INFLUX_DB, token=INFLUX_TOKEN, org=INFLUX_ORG)
    
    table_name = target_table
    if not table_name:
        try:
            tdf = client.query("SHOW TABLES").to_pandas()
            col = next((c for c in tdf.columns if c.lower() in ['table_name', 'name', 'table']), tdf.columns[-1])
            tables = tdf[col].tolist()
            if not tables:
                print("  ✗ 数据库中没有任何表！")
                return
            print(f"\n  [扫描] 发现 {len(tables)} 张可用表：")
            for i, t in enumerate(tables):
                print(f"    [{i+1}] {t}")
            choice = input("  请选择要巡检的表编号 (直接回车默认第一张): ").strip()
            try:
                idx = int(choice) - 1
                table_name = tables[idx] if 0 <= idx < len(tables) else tables[0]
            except: table_name = tables[0]
        except Exception as e:
            print(f"  ⚠ 扫描表失败: {e}")
            return

    print("=" * 80)
    print(f"  {table_name} 表数据结构详细报告")
    print("=" * 80)
    # 1. Schema
    schema = client.query(f"SELECT column_name, data_type FROM information_schema.columns WHERE table_name = '{table_name}' ORDER BY column_name").to_pandas()
    print(f"\n[1] 列结构（共 {len(schema)} 列）")
    print("-" * 80)
    for _, r in schema.iterrows():
        print(f"  {r['column_name']:20s}  {r['data_type']}")
    # 2. Row count
    cnt = int(client.query(f"SELECT COUNT(*) as cnt FROM \"{table_name}\"").to_pandas().iloc[0]['cnt'])
    print(f"\n[2] 总行数: {cnt:,}")
    # 3. Subjects
    subs = client.query(f"SELECT DISTINCT subject_id FROM \"{table_name}\"").to_pandas()
    print(f"\n[3] 被试: {len(subs)} 人 -> {sorted(subs.iloc[:,0].tolist())}")
    # 4. Videos
    vids = client.query(f"SELECT DISTINCT video_id FROM \"{table_name}\"").to_pandas()
    print(f"\n[4] 视频: {len(vids)} 个 -> {sorted(vids.iloc[:,0].tolist())}")
    # 5. Label
    print(f"\n[5] 标签分布 (confused):")
    for lab in ['yes', 'no']:
        try:
            n = int(client.query(f"SELECT COUNT(*) as n FROM \"{table_name}\" WHERE confused = '{lab}'").to_pandas().iloc[0]['n'])
            print(f"  confused = '{lab}': {n:,} 行")
        except:
            print(f"  confused = '{lab}': 查询失败")
    # 6. Sample
    print(f"\n[6] 前 5 行样本数据:")
    sample = client.query(f"SELECT * FROM \"{table_name}\" ORDER BY time LIMIT 5").to_pandas()
    cols = ['subject_id','video_id','time','delta','theta','alpha1','alpha2','beta1','beta2','gamma1','gamma2','attention','mediation','raw','confused','self_confused']
    show = [c for c in cols if c in sample.columns]
    print(sample[show].to_string(index=False))
    # 7. Stats
    print(f"\n[7] 频段能量统计:")
    bands = ['delta','theta','alpha1','alpha2','beta1','beta2','gamma1','gamma2','attention','mediation','raw']
    parts = []
    for b in bands:
        parts.append(f"CAST(AVG({b}) AS DOUBLE) as {b}_avg")
        parts.append(f"CAST(MIN({b}) AS DOUBLE) as {b}_min")
        parts.append(f"CAST(MAX({b}) AS DOUBLE) as {b}_max")
        parts.append(f"CAST(STDDEV({b}) AS DOUBLE) as {b}_std")
    stats = client.query("SELECT " + ", ".join(parts) + f" FROM \"{table_name}\"").to_pandas()
    print(f"  {'列名':<12s}  {'平均值':>14s}  {'标准差':>14s}  {'最小值':>14s}  {'最大值':>14s}")
    print(f"  {'-'*12}  {'-'*14}  {'-'*14}  {'-'*14}  {'-'*14}")
    for b in bands:
        avg = stats[f'{b}_avg'].iloc[0]
        std = stats[f'{b}_std'].iloc[0]
        mn = stats[f'{b}_min'].iloc[0]
        mx = stats[f'{b}_max'].iloc[0]
        print(f"  {b:<12s}  {avg:>14,.1f}  {std:>14,.1f}  {mn:>14,.1f}  {mx:>14,.1f}")


def run_export_report(*args, **kwargs):
    """导出 kaggle_eeg 全表数据，生成可视化 Markdown 文件"""
    client = InfluxDBClient3(host='http://localhost:8181', database='eeg_db', token='apiv3_token', org='')
    # 拉取全表数据
    print("正在拉取 kaggle_eeg 全部数据...")
    df = client.query("SELECT * FROM kaggle_eeg ORDER BY subject_id, time").to_pandas()
    print(f"拉取完成: {len(df)} 行")
    bands = ['delta','theta','alpha1','alpha2','beta1','beta2','gamma1','gamma2']
    extra = ['attention','mediation','raw']
    all_num = bands + extra
    # ============ 生成 Markdown ============
    md = []
    md.append("# 📊 kaggle_eeg 数据可视化报告\n")
    md.append(f"> 自动生成于 InfluxDB `eeg_db.kaggle_eeg` 表")
    md.append(f"> 总行数: **{len(df):,}** | 被试: **{df['subject_id'].nunique()}** 人 | 视频: **{df['video_id'].nunique()}** 个\n")
    # --- Section 1: Schema ---
    md.append("## 1. 数据字典（列定义）\n")
    md.append("| 列名 | 数据类型 | 角色 | 含义 |")
    md.append("|:---|:---|:---|:---|")
    schema_info = [
        ("subject_id", "TAG", "索引", "被试编号 (S0~S9)，共 10 名受试者"),
        ("video_id", "TAG", "索引", "教学视频编号 (V0~V9)，难度各异"),
        ("time", "Timestamp", "时间", "采样时间戳，每秒 1 帧 (1 Hz)"),
        ("confused", "TAG", "标签", "困惑标签：`yes`=困惑, `no`=不困惑（研究者预定义的标准答案）"),
        ("self_confused", "TAG", "标签", "受试者自评困惑标签，实验后主观回顾标注"),
        ("delta", "Float64", "频段", "**Delta 波 (0.5-4 Hz)**：深度睡眠/疲劳/走神的标志"),
        ("theta", "Float64", "频段", "**Theta 波 (4-8 Hz)**：困倦、白日梦、信息处理受阻时升高"),
        ("alpha1", "Float64", "频段", "**Low Alpha (8-10 Hz)**：放松但清醒，闭眼时增强，注意力集中时被抑制"),
        ("alpha2", "Float64", "频段", "**High Alpha (10-12 Hz)**：内在注意力、工作记忆加工"),
        ("beta1", "Float64", "频段", "**Low Beta (12-20 Hz)**：主动思考、集中注意力，做逻辑推理时升高"),
        ("beta2", "Float64", "频段", "**High Beta (20-30 Hz)**：紧张、焦虑、高度警觉时显著升高"),
        ("gamma1", "Float64", "频段", "**Low Gamma (30-50 Hz)**：高级认知功能，跨脑区信息整合"),
        ("gamma2", "Float64", "频段", "**High Gamma (50-100 Hz)**：感知绑定和意识加工，可能混入肌电伪迹"),
        ("alpha_total", "Float64", "合计", "Alpha 总能量 = alpha1 + alpha2"),
        ("beta_total", "Float64", "合计", "Beta 总能量 = beta1 + beta2"),
        ("gamma_total", "Float64", "合计", "Gamma 总能量 = gamma1 + gamma2"),
        ("attention", "Float64", "eSense", "注意力指数 (0-100)，NeuroSky 芯片内置算法计算"),
        ("mediation", "Float64", "eSense", "冥想/放松指数 (0-100)，高值=放松，低值=紧张"),
        ("raw", "Float64", "原始信号", "原始 EEG 电压 (-2048~2047)，所有频段的源头信号"),
    ]
    for name, dtype, role, desc in schema_info:
        md.append(f"| `{name}` | {dtype} | {role} | {desc} |")
    # --- Section 2: Overview Stats ---
    md.append("\n## 2. 全局统计摘要\n")
    md.append("### 2.1 频段能量分布\n")
    md.append("| 频段 | 平均值 | 标准差 | 最小值 | 中位数 | 最大值 |")
    md.append("|:---|---:|---:|---:|---:|---:|")
    for b in all_num:
        col = df[b].dropna()
        md.append(f"| `{b}` | {col.mean():,.0f} | {col.std():,.0f} | {col.min():,.0f} | {col.median():,.0f} | {col.max():,.0f} |")
    # --- Section 3: Label Distribution ---
    md.append("\n### 2.2 标签分布\n")
    confused_counts = df['confused'].value_counts()
    total = len(df)
    md.append("| 标签 | 含义 | 行数 | 占比 |")
    md.append("|:---|:---|---:|---:|")
    for lab in ['no', 'yes']:
        n = confused_counts.get(lab, 0)
        pct = n / total * 100
        meaning = "不困惑 (Focused)" if lab == 'no' else "困惑 (Confused)"
        bar = "█" * int(pct / 2)
        md.append(f"| `{lab}` | {meaning} | {n:,} | {pct:.1f}% {bar} |")
    # --- Section 4: Per-Subject ---
    md.append("\n## 3. 各被试数据分布\n")
    md.append("### 3.1 被试样本量与困惑比例\n")
    md.append("| 被试 | 总帧数 | 困惑帧 | 不困惑帧 | 困惑率 | 分布柱状图 |")
    md.append("|:---|---:|---:|---:|---:|:---|")
    for sid in sorted(df['subject_id'].unique()):
        sub_df = df[df['subject_id'] == sid]
        n_total = len(sub_df)
        n_yes = len(sub_df[sub_df['confused'] == 'yes'])
        n_no = n_total - n_yes
        pct = n_yes / n_total * 100 if n_total > 0 else 0
        bar_yes = "🟥" * int(pct / 5)
        bar_no = "🟩" * int((100 - pct) / 5)
        md.append(f"| {sid} | {n_total:,} | {n_yes:,} | {n_no:,} | {pct:.1f}% | {bar_no}{bar_yes} |")
    # --- Section 5: Per-Subject Band Means ---
    md.append("\n### 3.2 各被试频段平均能量\n")
    md.append("| 被试 | Delta | Theta | Alpha1 | Alpha2 | Beta1 | Beta2 | Gamma1 | Gamma2 | Attention | Mediation |")
    md.append("|:---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|")
    for sid in sorted(df['subject_id'].unique()):
        sub_df = df[df['subject_id'] == sid]
        vals = [f"{sub_df[b].mean():,.0f}" for b in bands]
        vals += [f"{sub_df['attention'].mean():.0f}", f"{sub_df['mediation'].mean():.0f}"]
        md.append(f"| {sid} | " + " | ".join(vals) + " |")
    # --- Section 6: Confused vs Not Confused comparison ---
    md.append("\n## 4. 困惑 vs 不困惑 频段能量对比\n")
    md.append("> 这是系统判定困惑的核心依据：对比两种状态下各频段的能量差异\n")
    md.append("| 频段 | 不困惑 (平均) | 困惑 (平均) | 变化率 | 方向 | 临床意义 |")
    md.append("|:---|---:|---:|---:|:---|:---|")
    df_no = df[df['confused'] == 'no']
    df_yes = df[df['confused'] == 'yes']
    meanings = {
        'delta': '疲劳/走神增加',
        'theta': '信息处理受阻',
        'alpha1': '放松状态减少',
        'alpha2': '工作记忆负荷变化',
        'beta1': '主动思考努力变化',
        'beta2': '焦虑/紧张变化',
        'gamma1': '认知整合能力变化',
        'gamma2': '高频认知活动变化',
        'attention': '注意力集中程度',
        'mediation': '身心放松程度',
    }
    for b in bands + ['attention', 'mediation']:
        avg_no = df_no[b].mean()
        avg_yes = df_yes[b].mean()
        change = (avg_yes - avg_no) / avg_no * 100 if avg_no != 0 else 0
        direction = "📈 升高" if change > 2 else "📉 降低" if change < -2 else "➡️ 持平"
        md.append(f"| `{b}` | {avg_no:,.0f} | {avg_yes:,.0f} | {change:+.1f}% | {direction} | {meanings.get(b, '')} |")
    # --- Section 8: Sample data per subject ---
    md.append("## 5. 各被试样本数据（每人前 5 行）\n")
    show_cols = ['subject_id','video_id','time','delta','theta','alpha1','alpha2','beta1','beta2','gamma1','gamma2','attention','mediation','confused']
    for sid in sorted(df['subject_id'].unique()):
        sub_df = df[df['subject_id'] == sid].head(5)
        md.append(f"### 被试 {sid}\n")
        header = "| " + " | ".join(show_cols) + " |"
        sep = "|" + "|".join(["---:" if c not in ('subject_id','video_id','confused','time') else ":---" for c in show_cols]) + "|"
        md.append(header)
        md.append(sep)
        for _, r in sub_df.iterrows():
            vals = []
            for c in show_cols:
                v = r[c]
                if c == 'time':
                    vals.append(str(v)[:19])
                elif isinstance(v, float) and c not in ('attention','mediation'):
                    vals.append(f"{v:,.0f}")
                else:
                    vals.append(str(v))
            md.append("| " + " | ".join(vals) + " |")
        md.append("")
    # --- Section 9: Cognitive signature explanation ---
    md.append("## 6. 困惑检测核心机理\n")
    md.append("""当学生处于**困惑状态**时，脑电波会呈现以下特征模式：
    ```
    困惑时的脑电信号模式:
    ┌──────────────────────────────────────────────────┐
    │  Theta ↑ (信息处理受阻，工作记忆超载)              │
    │  Alpha ↓ (无法进入轻松理解的状态)                  │
    │  Beta  ↑ (大脑拼命努力思考但未成功)                │
    │  Attention ↓ (注意力分散/涣散)                     │
    │                                                    │
    │  → Theta/Beta 比值 ↑ (核心困惑指标)                │
    │  → Theta/Alpha 比值 ↑ (认知负荷指标)               │
    │  → Engagement 指数 ↓ (参与度下降)                  │
    └──────────────────────────────────────────────────┘
    ```
    我们的 V9 引擎通过 **112 维特征工程**捕捉这些模式：
    - 原始 10 频段 → 6 种认知比值 = **16 维基础特征**
    - × 7 种时序变换（原始值 + 一阶差分 + 二阶差分 + 短窗均值 + 长窗均值 + 短窗方差 + 长窗方差）
    - = **112 维高阶时序特征空间**
    然后交由 XGBoost (300 棵树, GPU CUDA 加速) 进行 Subject-Dependent 5-Fold 交叉验证分类。
    """)
    # Write file
    output_path = r"C:\Users\ROG\Desktop\项目\MyDOC\kaggle_eeg_数据可视化报告.md"
    with open(output_path, 'w', encoding='utf-8') as f:
        f.write("\n".join(md))
    print(f"\n✅ 报告已生成: {output_path}")
    print(f"   共 {len(md)} 行 Markdown")


def run_simulate(*args, **kwargs):
    """
    模拟新用户脑电数据生成器 (EEG Data Simulator)
    ==============================================
    用途：生成一个虚拟的“新用户”数据并导入 InfluxDB，
    用于测试高精度诊断引擎的数据自适应能力。
    """
    warnings.filterwarnings('ignore')
    def log(msg):
        print(msg, flush=True)
    log("=" * 70)
    log("  正在模拟新用户脑电波数据 (Subject: S99)")
    log("=" * 70)
    # 1. 连接 InfluxDB
    client = InfluxDBClient3(host="http://localhost:8181", database="eeg_db", token="apiv3_token", org="")
    # 2. 生成模拟数据参数
    subject_id = "S99"  # 虚拟的新用户 ID
    video_ids = ["V1", "V2"]  # 看两个视频，一个是放松的，一个是困惑的
    sample_count = 500  # 每个视频生成 500 条数据 (约 4 分钟)
    points = []
    base_time = datetime.utcnow()
    log(f"  [1/2] 正在生成 {subject_id} 的虚拟脑电波...")
    for vid in video_ids:
        is_confused = 'yes' if vid == "V2" else 'no'
        for i in range(sample_count):
            # 模拟真实的脑电频段波动 (加入随机噪声和基线偏移)
            # 困惑时 Theta 和 Beta 稍微高一点，Alpha 稍微低一点
            base_multiplier = 1.2 if is_confused == 'yes' else 0.8
            delta = np.abs(np.random.normal(500000, 100000))
            theta = np.abs(np.random.normal(150000 * base_multiplier, 30000))
            alpha1 = np.abs(np.random.normal(30000 / base_multiplier, 10000))
            alpha2 = np.abs(np.random.normal(20000 / base_multiplier, 8000))
            beta1 = np.abs(np.random.normal(20000 * base_multiplier, 5000))
            beta2 = np.abs(np.random.normal(15000 * base_multiplier, 4000))
            gamma1 = np.abs(np.random.normal(5000, 2000))
            gamma2 = np.abs(np.random.normal(3000, 1000))
            attention = float(np.random.randint(20, 100))
            mediation = float(np.random.randint(20, 100))
            point_time = base_time + timedelta(milliseconds=i * 500) # 每 0.5 秒一条
            # 组装 InfluxDB Point
            p = Point("kaggle_eeg") \
                .tag("subject_id", subject_id) \
                .tag("video_id", vid) \
                .tag("confused", is_confused) \
                .field("delta", float(delta)) \
                .field("theta", float(theta)) \
                .field("alpha1", float(alpha1)) \
                .field("alpha2", float(alpha2)) \
                .field("beta1", float(beta1)) \
                .field("beta2", float(beta2)) \
                .field("gamma1", float(gamma1)) \
                .field("gamma2", float(gamma2)) \
                .field("attention", float(attention)) \
                .field("mediation", float(mediation)) \
                .time(point_time)
            points.append(p)
        base_time = base_time + timedelta(minutes=5) # 换视频间隔 5 分钟
    # 3. 批量写入数据库
    log(f"  [2/2] 正在将 {len(points)} 条数据写入 InfluxDB (eeg_db)...")
    client.write(record=points)
    log("\n" + "=" * 70)
    log(f"  ✅ 模拟数据写入完成！")
    log(f"  新增样本数: {len(points)}")
    log(f"  你可以再次运行 eeg_high_accuracy_analyzer.py 观察总数据量的变化了。")
    log("=" * 70)


def run_route_a_neurora(target_table=None, *args, **kwargs):
    """
    EEG 困惑检测 - 路线A：NeuroRA 手册方法 (tbyt_decoding_kfold)
    ============================================================
    适用场景：高频原始脑电数据、多导联设备、学术论文规范要求
    数据源：InfluxDB eeg_db/kaggle_eeg
    验证准确率：Peak ~65% (低频预处理数据) / 更高 (高频原始数据)
    """
    matplotlib.use('Agg')
    warnings.filterwarnings('ignore')
    plt.rcParams["figure.dpi"] = 150
    output_file = open(r"C:\Users\ROG\Desktop\项目\neurora_output.txt", "w", encoding="utf-8")
    def log(msg):
        print(msg)
        output_file.write(msg + "\n")
        output_file.flush()
    log("=" * 65)
    log("  Route A: NeuroRA Handbook Method (tbyt_decoding_kfold)")
    log("=" * 65)
    client = InfluxDBClient3(host=INFLUX_HOST, database=INFLUX_DB, token=INFLUX_TOKEN, org=INFLUX_ORG)
    
    table_name = target_table
    if not table_name:
        try:
            tdf = client.query("SHOW TABLES").to_pandas()
            col = next((c for c in tdf.columns if c.lower() in ['table_name', 'name', 'table']), tdf.columns[-1])
            tables = tdf[col].tolist()
            if not tables:
                print("  ✗ 数据库中没有任何表！")
                return
            print(f"\n  [扫描] 发现 {len(tables)} 张可用表：")
            for i, t in enumerate(tables):
                print(f"    [{i+1}] {t}")
            choice = input("  请选择要分析的表编号 (直接回车默认第一张): ").strip()
            try:
                idx = int(choice) - 1
                table_name = tables[idx] if 0 <= idx < len(tables) else tables[0]
            except: table_name = tables[0]
        except Exception as e:
            print(f"  ⚠ 扫描表失败: {e}")
            return

    df = client.query(f"SELECT time, subject_id, video_id, delta, theta, alpha1, alpha2, beta1, beta2, gamma1, gamma2, attention, mediation, confused, self_confused FROM \"{table_name}\" ORDER BY subject_id, video_id, time").to_pandas()
    def parse_id(val, prefix):
        s = str(val).strip()
        return int(float(s[len(prefix):])) if s.startswith(prefix) else int(float(s)) if str(val).strip() else -1
    df['sub'] = df['subject_id'].apply(lambda x: parse_id(x, 'S'))
    df['vid'] = df['video_id'].apply(lambda x: parse_id(x, 'V'))
    df['label'] = (df['self_confused'].astype(str).str.strip().str.lower() == 'yes').astype(int)
    df = df[df['sub'] >= 0].copy().drop_duplicates(subset=['sub','vid','delta','theta']).sort_values(by=['sub', 'vid', 'time']).reset_index(drop=True)
    df['alpha_total'] = df['alpha1'] + df['alpha2']
    df['beta_total'] = df['beta1'] + df['beta2']
    df['theta_beta_ratio'] = df['theta'] / (df['beta_total'] + 1e-6)
    df['engagement'] = df['beta1'] / (df['alpha_total'] + df['theta'] + 1e-6)
    core_feats = ['delta','theta','alpha1','alpha2','beta1','beta2','gamma1','gamma2','attention','mediation','theta_beta_ratio','engagement']
    group = df.groupby(['sub', 'vid'])
    for col in core_feats:
        df[col + '_diff'] = group[col].diff().fillna(0)
        df[col + '_mean'] = group[col].rolling(3, min_periods=1).mean().reset_index([0,1], drop=True)
        df[col + '_std'] = group[col].rolling(3, min_periods=1).std().fillna(0).reset_index([0,1], drop=True)
    V3_feats = core_feats + [c+'_diff' for c in core_feats] + [c+'_mean' for c in core_feats] + [c+'_std' for c in core_feats]
    n_ch = len(V3_feats)
    log(f"  Feature expansion: 8 -> {n_ch} channels")
    WIN, STEP = 10, 5
    subjects = sorted(df['sub'].unique())
    n_subs = len(subjects)
    trials_by_sub = {s: ([], []) for s in subjects}
    for sub in subjects:
        for vid in sorted(df[df['sub']==sub]['vid'].unique()):
            seg = df[(df['sub']==sub) & (df['vid']==vid)]
            vals = seg[V3_feats].values.astype(float)
            lab = int(seg['label'].mode().iloc[0])
            for i in range(0, len(vals) - WIN + 1, STEP):
                trials_by_sub[sub][0].append(vals[i:i+WIN].T)
                trials_by_sub[sub][1].append(lab)
    min_t = min(len(trials_by_sub[s][0]) for s in subjects)
    data = np.zeros([n_subs, min_t, n_ch, WIN])
    labels = np.zeros([n_subs, min_t])
    for i, s in enumerate(subjects):
        for j in range(min_t):
            data[i,j] = trials_by_sub[s][0][j]
            labels[i,j] = trials_by_sub[s][1][j]
    log(f"  Tensor shape: {data.shape}")
    CACHE_FILE = "C:/Users/ROG/Desktop/项目/neurora_hybrid_cache.npy"
    if os.path.exists(CACHE_FILE):
        log(f"\n  [CACHE HIT] Loading {os.path.basename(CACHE_FILE)}")
        accs = np.load(CACHE_FILE)
    else:
        log(f"\n  [RUNNING] tbyt_decoding_kfold...")
        from neurora.decoding import tbyt_decoding_kfold
        navg = max(2, min_t // 20)
        accs = tbyt_decoding_kfold(data, labels, n=2, navg=navg, time_win=2, time_step=2, nfolds=3, nrepeats=10, smooth=True)
        np.save(CACHE_FILE, accs)
        log("  Completed & Cached.")
    avg = np.mean(accs, axis=0)
    log(f"\n{'=' * 65}")
    log(f"  Route A Results (NeuroRA Handbook)")
    log(f"{'=' * 65}")
    log(f"  Peak Accuracy: {np.max(avg)*100:.2f}%")
    log(f"  Mean Accuracy: {np.mean(avg)*100:.2f}%")
    for i, s in enumerate(subjects):
        log(f"    Subject {s}: peak {np.max(accs[i])*100:.2f}%")
    sig = sum(1 for t in range(accs.shape[1]) if ttest_1samp(accs[:,t], 0.5)[1] < 0.05 and np.mean(accs[:,t]) > 0.5)
    log(f"  Significant Time-Windows: {sig}/{accs.shape[1]} (p<0.05)")
    try:
        from neurora.rsa_plot import plot_tbyt_decoding_acc
        td, ti = WIN * 0.5, (WIN * 0.5) / accs.shape[1]
        plot_tbyt_decoding_acc(accs, start_time=0, end_time=td, time_interval=ti, chance=0.5, p=0.05, cbpt=True, stats_time=[0, td], xlim=[0, td], ylim=[0.3, 0.9])
        plt.savefig("C:/Users/ROG/Desktop/项目/neurora_hybrid_result.png", dpi=150, bbox_inches='tight')
        log("  Plot saved: neurora_hybrid_result.png")
    except: pass
    output_file.close()


def run_knowledge():
    print('---\nname: "EEG 领域知识库 (Knowledge Base - 深度专家版)"\ndescription: "给 AI 注入极度详实的 EEG 脑电波专业背景知识，涵盖神经物理机制、信号处理、频段微观解析、机器学习最佳实践及本项目完整工具链。"\n---\n\n# 🧠 EEG 脑电波领域专业知识库 (AI 认知增强指南 - 深度专家版)\n\n## 🎯 你的任务 (Instructions)\n当你作为科研助手或代码专家，需要向用户解释脑电波现象、分析模型提取的频段特征，或者在编写与 EEG 相关的论文及算法时，**必须严格参考本深度知识库**。不可凭借模糊常识进行脑补。\n\n---\n\n## 1. ⚡ EEG 产生的神经物理机制 (Neuro-Physical Mechanisms)\n\n### 1.1 微观神经起源：突触后电位 (PSPs)\n- EEG 的主要来源**不是**神经元发放的动作电位（Action Potentials, APs），因为 AP 持续时间极短（约 1ms），且电流方向杂乱，无法在头皮上有效叠加。\n- 真实的信号源是皮层内**锥体细胞（Pyramidal Cells）**产生的**兴奋性/抑制性突触后电位（EPSP/IPSP）**。这些电位持续时间较长（10~100ms），且锥体细胞在皮层中排列整齐（垂直于皮层表面），使得电场能够在空间上同向叠加，形成足以穿透颅骨的**偶极子（Dipoles）**。\n\n### 1.2 宏观容积传导效应 (Volume Conduction)\n- 头皮采集到的微弱电压（10~100 μV），是经过脑脊液、脑膜、颅骨（电阻极高）和头皮层层衰减、模糊化后的结果。\n- **空间分辨率极差**：容积传导效应导致某一个电极记录到的信号，实际上是大面积脑区活动的混合（甚至包含对侧半球的信号），因此 EEG 在空间定位上存在先天的局限性。\n\n### 1.3 时间分辨率的绝对优势\n- EEG 的时间分辨率可达**毫秒级（1ms 以下）**，远优于 fMRI（秒级）和 PET（分钟级）。这使得 EEG 成为追踪快速认知状态变化（如"困惑"出现的瞬间）的理想工具。\n\n### 1.4 常见伪迹类型 (Artifacts)\n在分析 EEG 数据前，必须意识到以下噪声源可能严重污染信号：\n| 伪迹类型 | 来源 | 频率特征 | 影响 |\n|:---|:---|:---|:---|\n| **眼电 (EOG)** | 眨眼、眼球运动 | 低频为主 (<4Hz)，幅度极大（可达 200μV） | 前额电极（Fp1/Fp2）受影响最严重 |\n| **肌电 (EMG)** | 咬牙、皱眉、吞咽 | 高频为主 (>20Hz)，宽带噪声 | 污染 Beta 和 Gamma 频段 |\n| **工频干扰** | 电源线辐射 | 50Hz (中国/欧洲) 或 60Hz (美国) | 窄带尖峰，需 Notch Filter 消除 |\n| **心电 (ECG)** | 心脏搏动 | 周期性脉冲，约 1Hz | 在耳后参考电极中尤为明显 |\n| **运动伪迹** | 头部晃动、电极松动 | 极低频漂移 (<1Hz) | 导致基线飘移 |\n\n---\n\n## 2. 📍 电极与导联系统 (Electrode Systems)\n\n### 2.1 国际 10-20 与 10-10 系统\n- 命名规则：左脑为奇数，右脑为偶数，z 代表中线（Midline）。\n- 字母编码：`Fp` (前额极 Frontopolar), `F` (额叶 Frontal), `C` (中央区 Central), `P` (顶叶 Parietal), `T` (颞叶 Temporal), `O` (枕叶 Occipital)。\n- 10-20 系统包含 21 个标准电极位置；10-10 系统扩展至 64/128/256 个。\n\n### 2.2 参考电极方案 (Reference Schemes)\n| 方案 | 原理 | 优缺点 |\n|:---|:---|:---|\n| **单极参考** (Cz/鼻尖/耳垂) | 所有电极相对于同一参考点记录 | 简单，但参考点本身也有脑电活动 |\n| **平均参考** (Average Reference) | 所有电极电位的平均值作为参考 | 减少偏差，但在电极数量少时不稳定 |\n| **双极参考** (Bipolar) | 相邻两电极之差 | 突出局部活动，临床癫痫定位常用 |\n\n### 2.3 前额叶单导联 (Fp1, Fp2) 为什么适合"困惑检测"？\n- **高级认知中枢**：前额叶皮层（PFC）是人类执行控制、工作记忆、情绪调节和**决策解决冲突（即"困惑"）**的核心脑区。\n- **便携性与妥协**：单导联脑电设备（如 NeuroSky MindWave）通常将电极放置在前额。虽然牺牲了全脑网络连通性的视野，但最大程度保留了最直观的认知负荷特征。\n- **致命弱点**：前额位置极易受到**眼电（EOG）**和**额肌肌电（EMG）**的污染。模型必须具备强大的非线性抗噪能力。\n\n---\n\n## 3. 🌊 脑电频谱特征的微观解构 (Micro-analysis of Frequency Bands)\n\n### 3.1 频谱提取方法\n- **快速傅里叶变换 (FFT)**：将时域信号转换为频域功率谱密度 (PSD)。适合平稳信号段。\n- **短时傅里叶变换 (STFT)**：加窗 FFT，适合观察频率随时间的变化。\n- **小波变换 (Wavelet Transform)**：更灵活的时频分析，对非平稳 EEG 尤其有效。\n- **Hilbert-Huang 变换 (HHT)**：基于经验模态分解 (EMD)，完全数据驱动。\n\n### 3.2 频段与认知状态映射表\n\n| 频段名称 | 频率范围 (Hz) | 认知神经科学深度解析 | 在"困惑(Confusion)"研究中的权重 |\n|:---|:---|:---|:---|\n| **Delta** | 0.5-4 Hz | 丘脑皮层网络主导。清醒态高Delta常意味极度疲劳或无聊。 | 底噪参考。**实测: 困惑686,300 vs 不困惑500,638 (+37%)** |\n| **Theta** | 4-8 Hz | 海马体+额叶中线回路。**工作记忆负荷过载的金标准**。 | **极高(实测涨幅最大)。困惑197,350 vs 不困惑126,784 (+56%), StdDev+78,382** |\n| **Alpha1** | 8-10 Hz | 与皮层唤醒成反比。经典理论预测困惑时ERD下降。 | **实测与经典ERD理论不符**: 困惑时绝对PSD不降反升(49,255 vs 32,178, +53%)。见3.4节 |\n| **Alpha2** | 10-13 Hz | 语义记忆检索/心算相关皮层活动。mu节律高频端。 | **实测同样不降反升**(39,371 vs 26,112, +51%)。必须用比值指标判别 |\n| **Beta1** | 13-20 Hz | 感觉运动皮层激活,持续专注维持(Sustained Attention)。 | 适度上升=努力听讲。**实测: 困惑27,624 vs 不困惑19,326 (+43%)** |\n| **Beta2** | 20-30 Hz | 焦虑、认知冲突和挫败感。ADHD研究重要指标。 | **实测: 困惑39,014 vs 不困惑35,938 (+8.6%, 涨幅最小)。这是Engagement下降的根因** |\n| **Gamma** | 30-100 Hz | 跨脑区特征绑定,顿悟时刻(Aha Moment)标志。 | 易受EMG污染。**实测: Gamma1波动性在困惑时反而下降(StdDev -5,397), 唯一下降频段** |\n| **Attention** | NeuroSky专有 | 设备ASIC芯片内置算法输出的注意力指数(0-100)。 | **实测: 困惑时显著下降(38.61 vs 44.12, -12.5%), 唯一直接下降的原始特征** |\n| **Mediation** | NeuroSky专有 | 设备ASIC芯片内置算法输出的冥想/放松度(0-100)。 | **实测: 困惑时轻微下降(46.64 vs 47.76, -1.12), 区分力弱于Attention** |\n\n### 3.3 频段间的动态关系 (Cross-Frequency Coupling)\n- **相位-幅度耦合 (PAC)**：低频节律（如 Theta）的相位调制高频节律（如 Gamma）的幅度。这是大脑实现工作记忆和信息整合的核心机制之一。在学习过程中，强 Theta-Gamma 耦合代表有效的信息编码。\n- **频段竞争 (Spectral Tilt)**：Alpha 和 Beta 往往呈跷跷板关系——放松时 Alpha 升高 Beta 降低，专注时反之。\n\n### 3.4 关键实证发现：绝对 PSD 的"同涨陷阱" (The Co-Rise Trap)\n\n> **这是本项目通过 kaggle_eeg (6,451帧, 10名被试) 实测发现的最重要的反直觉规律。**\n\n**现象**：困惑状态下，所有8个频段的绝对PSD能量均同向上升，没有任何一个频段的绝对均值在困惑时下降。这与经典教科书中"困惑时Alpha去同步化(ERD)下降"的理论严重矛盾。\n\n各频段困惑涨幅排序：Theta(+56%) > Alpha1(+53%) > Alpha2(+51%) > Beta1(+43%) > Delta(+37%) > Gamma2(+29%) > Beta2(+8.6%) > Gamma1(+7.7%)\n\n**解释**：NeuroSky 单导联输出的是绝对功率谱密度(Absolute PSD)。困惑时大脑整体皮层激活水平急剧攀升，导致频谱总功率大幅增加。在此基底上，低频慢波(Theta/Alpha)的涨幅远超高频快波(Beta/Gamma)，使得慢波在总功率中的占比实际上是增大的——这与ERD理论在相对功率维度上并不矛盾。\n\n**致命教训**：\n- 绝不能用绝对PSD值的升降来直接判断认知状态，否则AI会错误推断"Alpha上升=放松=不困惑"\n- 必须使用频段间的比值指标(如Engagement=Beta/(Alpha+Theta))来消除总功率波动干扰\n- 在单导联设备上，Attention(设备内置指数)是唯一在绝对值上直接下降的可靠指标(44.12->38.61, -12.5%)\n\n### 3.5 实测波动性差异：困惑时的神经不稳定性 (Neural Instability)\n\n困惑状态下，绝大多数频段的标准差(StdDev)均显著高于不困惑状态，说明困惑时神经活动更加混乱与不稳定：\n- Theta StdDev差异最大: +78,382 (困惑269,910 vs 不困惑191,528)\n- Alpha2: +25,159 | Alpha1: +23,892 | Delta: +59,914\n- Gamma1是唯一波动率下降的频段: -5,397\n\n**结论**：困惑不仅改变了频段能量的水平，更剧烈地改变了能量的波动幅度。这正是V9引擎引入Rolling Std(滑动标准差)特征的实证基础——波动率本身就是一个极其强大的认知状态区分器。\n\n---\n\n## 4. 🧮 衍生认知特征：比值指标的降维打击 (Cognitive Ratios)\n\n在机器学习中，单纯输入绝对频段功率是不够的。大脑的认知状态往往体现在不同频段的对抗与平衡中：\n\n| 比值指标 | 公式 | 生理意义 | 困惑判定依据 | 实测验证 |\n|:---|:---|:---|:---|:---|\n| **TBR** | theta/(beta1+beta2) | 认知负担vs注意力 | 升高=认知超载 | 困惑3.87 vs 不困惑3.25 (+19%) |\n| **TAR** | theta/(alpha1+alpha2) | 内部加工vs外部感知 | 升高=内部挣扎 | 困惑3.20 vs 不困惑2.78 (+15%) |\n| **ABR** | (alpha1+alpha2)/(beta1+beta2) | 放松度vs焦虑度 | 骤降=挫败感 | 困惑1.60 vs 不困惑1.46 (+10%, 方向相反, 受同涨陷阱影响) |\n| **Engagement** | (beta1+beta2)/(alpha1+alpha2+theta) | NASA沉浸度指标 | 下降=陷入困惑 | **困惑0.37 vs 不困惑0.46 (-19.6%, 最可靠指标)** |\n| **Fatigue** | (alpha1+alpha2+theta)/(beta1+beta2) | Engagement倒数 | 升高=疲劳累积 | 困惑5.47 vs 不困惑4.71 (+16%) |\n| **Focus** | attention/mediation | NeuroSky专属比值 | 捕捉设备算法趋势 | 困惑1.03 vs 不困惑0.90 (+14%, 反直觉, 见下方) |\n\n### 4.2 实测比值的反直觉发现与解读\n\n**发现一：ABR(Alpha/Beta)在困惑时不降反升**\n经典理论预测困惑时Alpha降Beta升导致ABR下降。但实测中由于"同涨陷阱"(见3.4节)，Alpha涨幅(+53%)远超Beta2涨幅(+8.6%)，导致ABR反而上升。结论：在单导联绝对PSD数据上，只有包含Theta的比值(TBR、TAR、Engagement)才是可靠的认知负荷判别器。\n\n**发现二：Focus Ratio在困惑时反直觉上升**\n困惑时Focus=Attention/Mediation反而略高(1.03 vs 0.90)。虽然Attention下降了5.5分，但Mediation也同步下降了1.1分。困惑的学生在主观上仍在"努力集中注意力"(哪怕实际认知效率已崩溃)。结论：Focus Ratio不适合作为困惑的独立判别指标，应与Engagement联合使用。\n\n**发现三：Engagement是最可靠的单一认知负荷指标**\n在所有6个比值中，Engagement变化方向最稳定、幅度最大(-19.6%)，完美抵消了"同涨陷阱"干扰(分母alpha+theta涨幅远大于分子beta涨幅)。AI在需要快速判断时，应优先参考Engagement指数。\n\n---\n\n## 5. 🤖 EEG 结合机器学习的铁律 (ML Best Practices for EEG)\n\n当你负责审查或编写 EEG 算法时，必须牢记以下红线原则：\n\n### 5.1 非平稳性 (Non-stationarity)\n- 人类脑电信号每时每刻都在漂移。禁止跨越太长的时间维度进行粗暴的全局统计。\n- 必须引入**滑动窗口均值/方差（Rolling Mean/Std）**以及**多阶差分（Diff）**来捕捉动态趋势。\n- 这正是 V9 引擎将 10 维扩展为 112 维的核心理由。\n\n### 5.2 个体差异性 (Subject-Dependency)\n- 不同人的颅骨厚度、头皮阻抗、大脑沟回结构完全不同！一个人的 Alpha 波峰值在 9Hz，另一个可能在 11Hz。\n  - ❌ **致命错误**：将所有人的 EEG 数据混在一起进行全局 Z-Score 标准化 → 数据泄露 + 身份混淆。\n  - ✅ **正确做法**：Subject-Dependent K-Fold（每人独立训练+验证），Z-Score 仅在训练折内计算。\n\n### 5.3 为什么选 XGBoost 而非深度学习？\n| 维度 | XGBoost | CNN/RNN |\n|:---|:---|:---|\n| 样本需求 | 数百到数千即可 | 通常需要数万+ |\n| 单导联适配 | 完美匹配结构化频段特征 | 需要多导联的空间拓扑 |\n| 抗噪能力 | 基于树的分裂对离群值鲁棒 | 对噪声敏感，易过拟合 |\n| 可解释性 | 可输出特征重要性排序 | 黑盒 |\n| 训练速度 | GPU 加速下秒级完成 | 需要复杂的超参调优 |\n\n### 5.4 交叉验证中的数据泄露 (Data Leakage Checklist)\n- ✅ Z-Score 标准化的 `mean` 和 `std` 必须**仅从训练折**中计算。\n- ✅ 滑动窗口特征不会跨越训练/测试边界（因为是按被试内部时间序列计算的）。\n- ✅ 特征工程不使用标签信息（所有衍生特征来源于物理信号本身）。\n- ❌ 绝不能在切分数据前进行 `fit_transform`。\n\n### 5.5 从 kaggle_eeg 实测数据中提炼的经验规律 (Empirical Rules)\n以下规律均来自对 kaggle_eeg (6,451帧, 10名被试S0-S9) 的统计分析，已用88.04%准确率验证：\n\n1. **绝对值无用论**：在单导联PSD数据中，所有频段的绝对值在困惑时都是上升的(详见3.4节"同涨陷阱")。绝不能用"Theta值高=困惑"这种简单阈值逻辑。必须使用比值指标或Z-Score标准化后的相对变化。\n2. **Theta涨幅霸权**：在所有频段中，Theta的困惑涨幅最大(+56%)，波动性增幅也最大(+78,382)。Theta是困惑检测中最核心的单一频段，其一阶差分(Theta_d1)和滑动标准差(Theta_std_w3)是XGBoost特征重要性排名中的常客。\n3. **Attention是唯一直降指标**：在所有原始特征中，只有NeuroSky的Attention指数在困惑时直接下降(-12.5%)。设备ASIC芯片已在硬件层完成了某种"相对化"处理，其输出值比原始频段功率更可信。\n4. **被试间困惑率差异巨大**：S7困惑率61.8%, S8仅40.2%。20+百分点的差异再次证明Subject-Dependent建模的必要性——不同学生对同一内容的主观困惑阈值完全不同。\n5. **波动率本身就是特征**：困惑时Theta的StdDev比不困惑时高出78,382(+41%)，而Gamma1是唯一波动率下降的频段。这种"波动模式差异"是V9引擎引入Rolling Std的实证理由。\n\n---\n\n## 6. 🛠️ 本项目工具链全景图 (V9 Toolkit Overview)\n\n以下是存放在 `C:\\Users\\ROG\\Desktop\\项目\\LLM_Skills\\` 目录下的完整工具链。所有脚本均使用 `.skills` 后缀，由 Python 编写，可通过终端直接执行。\n\n### 6.1 核心分析引擎\n\n| 脚本文件 | 用途 | 技术栈 | 输出 |\n|:---|:---|:---|:---|\n| `eeg_high_accuracy_analyzer.skills` | **主力引擎**：对 InfluxDB 中的脑电数据执行 Subject-Dependent 高精分类 | XGBoost-300 + 112维特征 + GPU CUDA | 每个被试的 5-Fold CV 准确率 + 全局平均 |\n| `eeg_route_a_neurora.skills` | **备用引擎**：基于《Python 脑电手册》的 NeuroRA 方法 | 48维虚拟导联 + 4D张量 + SVM 逐时间窗口解码 | 每个时间点的解码准确率 + 聚类置换检验显著性 |\n\n### 6.2 数据管理工具\n\n| 脚本文件 | 用途 | 触发场景 |\n|:---|:---|:---|\n| `eeg_universal_importer.skills` | 智能 CSV 导入器：自动识别异构列名（正则同义词字典），标准化后写入 InfluxDB | 用户要导入新的脑电数据集时 |\n| `simulate_new_eeg_data.skills` | 虚拟数据生成器：随机生成带噪声的 10 频段假脑电波 + 标签，写入 `eeg_db` | 测试数据库连接或验证算法流转时 |\n\n### 6.3 运维与报告工具\n\n| 脚本文件 | 用途 | 触发场景 |\n|:---|:---|:---|\n| `_inspect_db.skills` | 数据库健康巡检：检查 Schema、行数、被试列表、标签分布、缺失值 | 用户说"检查数据库"或怀疑数据异常时 |\n| `_export_md.skills` | Markdown 报告导出器：从 InfluxDB 抓取全表数据，生成统计报告至 `MyDOC/` | 用户说"导出报告"或"生成可视化"时 |\n\n### 6.4 数据库连接信息\n- **InfluxDB 3 Core**: `http://localhost:8181`\n- **数据库名**: `eeg_db`\n- **Token**: `apiv3_token`\n- **唯一活跃表**: `kaggle_eeg`（6,451 行，10 名被试 S0-S9，经严格去重审计）\n- **诊断标签**: `self_confused`（主观自评，当前使用），`confused`（客观刺激，已弃用但保留在表中）\n- **标签分布**: 自评困惑 3,308 帧 (51.3%) / 不困惑 3,143 帧 (48.7%)\n- **最新验证准确率**: **93.07%**（V9.2 优化版, 240维特征, 500树depth=7正则化, Subject-Dependent 5-Fold CV）\n\n### 6.5 V9 → V9.1 → V9.2 优化记录 (Knowledge-Driven Optimization Log)\n\n| 版本 | 特征维度 | 模型配置 | 平均准确率 | 关键改动 |\n|:---|:---|:---|:---|:---|\n| V9 原版 | 112维 | 300树 depth=8 | 88.04% | 基线 |\n| V9.1 | 192维 | 300树 depth=8 | 89.15% | +相对功率, +CV, Engagement修正 |\n| **V9.2** | **240维** | **500树 depth=7 正则化** | **93.07%** | +W=7窗口, +subsample/colsample/reg正则化 |\n\nV9.2 关键优化细节：\n1. **相对功率特征 (+8维)**：band/total_power，消除"同涨陷阱"（知识库3.4）\n2. **Engagement 公式修正**：beta_total/(alpha+theta)，与实测最可靠指标对齐（知识库4.2）\n3. **变异系数 CV (+24维)**：std/mean 归一化波动率（知识库3.5）\n4. **大窗口 W=7 (+48维)**：捕捉3.5秒长程认知趋势，S7从88%→94.5%\n5. **XGBoost 正则化**：subsample=0.8, colsample=0.7, min_child_weight=3, reg_lambda=1.5, 500树depth=7。S6从82.8%→91.8%(+9%)\n\n---\n\n## 7. 📚 关键学术文献索引 (Key References)\n\n当你写论文或向用户解释方法论时，可以引用以下权威来源：\n- **Berger, H. (1929)**：人类脑电图的首次记录，Alpha 波的发现者。\n- **Jasper, H. (1958)**：提出国际 10-20 电极安放系统标准。\n- **Pope, A.T., Bogart, E.H., Bartolome, D.S. (1995)**：提出 Engagement Index (β/(α+θ))，NASA 飞行员认知负荷研究。\n- **Wang et al. (2013)**：Kaggle EEG 困惑数据集的来源论文，使用 NeuroSky 设备在 MOOC 教学场景中采集前额脑电。\n- **Chen, T. & Guestrin, C. (2016)**：XGBoost 原始论文，"XGBoost: A Scalable Tree Boosting System"。\n- **Lu, Y. et al. (2021)**：《Python EEG Handbook》，NeuroRA 工具箱的设计与实践。\n\n---\n\n## 8. 🔬 EEG 数据质量自检清单 (Data Quality Checklist)\n\n当你被要求审查或诊断 EEG 数据问题时，按此清单逐项排查：\n1. **被试 ID 格式一致性**：是否存在 `S0` 与 `S0.0000...e+00` 的科学计数法重复？\n2. **数据行数校验**：`kaggle_eeg` 基准为 6,451 行。显著偏离说明存在重复导入或数据丢失。\n3. **标签平衡性**：self_confused 困惑/不困惑比例应接近 51:49。极端失衡需检查导入逻辑。\n4. **频段值域合理性**：所有频段功率值应为非负浮点数。出现负值或 NaN 说明数据损坏。\n5. **时间戳单调性**：同一被试内的时间戳应严格递增。乱序说明排序或导入出错。\n6. **冗余表检查**：生产库中应**仅存在 `kaggle_eeg` 一张表**。出现 `github_eeg`、`kaggle_motion` 等历史残留表，需立即清理。\n')


def run_troubleshoot():
    print('---\nname: "EEG 数据异常诊断专家"\ndescription: "当分析结果异常时，自动排查数据质量、特征工程和模型配置中的常见陷阱。"\n---\n\n# 🩺 EEG 数据异常诊断专家\n\n## 🎯 你的任务 (Instructions)\n当用户反馈"准确率异常"、"结果不对劲"、"数据好像有问题"时，按照以下诊断决策树，**逐层排查**问题根源。\n\n---\n\n## 🔍 诊断决策树\n\n### 症状 1：准确率异常偏高（>95%）\n```\n可能原因 → 排查步骤\n├── 数据泄露\n│   ├── Z-Score 是否在全局执行了 fit_transform？ → 检查 StandardScaler 的调用位置\n│   ├── 是否跨被试混洗了数据？ → 检查 train_test_split 之前有无按 subject_id 分组\n│   └── 特征工程中是否使用了标签信息？ → 审查 build_features 函数\n├── 数据重复\n│   ├── subject_id 是否有科学计数法重复？ → 运行 _inspect_db.skills 检查\n│   └── 是否多次导入导致行数翻倍？ → 基准行数应为 12,811\n└── 合成数据混入\n    └── 是否有 simulate_new_eeg_data 生成的虚拟数据残留？ → 检查被试 ID 中有无 S99 等非标ID\n```\n\n### 症状 2：准确率异常偏低（<60%）\n```\n可能原因 → 排查步骤\n├── 标签错误\n│   ├── confused 列的值是 \'yes\'/\'no\' 还是 1/0？ → 检查标签映射逻辑\n│   └── 标签是否严重不均衡？ → 检查 value_counts()\n├── 特征问题\n│   ├── 频段列名是否匹配？ → 核对 bands 列表与实际列名\n│   ├── 是否存在大量 NaN/0 值？ → 检查 df.isnull().sum()\n│   └── 特征维度是否正确（应为 112）？ → 打印 X.shape[1]\n├── 模型配置\n│   ├── n_estimators 是否太少？ → 基准配置为 300\n│   └── max_depth 是否太浅？ → 基准配置为 8\n└── 数据量不足\n    └── 某被试样本数是否低于 50？ → 打印各被试的 sample count\n```\n\n### 症状 3：某个被试的准确率远低于其他人\n```\n可能原因 → 排查步骤\n├── 该被试的标签几乎全是同一类 → 检查该被试的 label 分布\n├── 该被试的脑电信号波动极小（如全程走神/睡觉） → 检查该被试的频段方差\n├── 该被试的数据行数极少 → 数据不足以支撑 5-Fold 验证\n└── 该被试可能是离群个体（个体差异的正常现象） → 在论文中作为 limitation 讨论\n```\n\n---\n\n## 🛠️ 快速修复指令\n\n| 问题 | 一键修复命令 |\n|:---|:---|\n| 怀疑数据重复/脏数据 | 运行 `_inspect_db.skills` 进行全面巡检 |\n| 需要重新导入干净数据 | 先删表再运行 `eeg_universal_importer.skills` |\n| 需要验证算法是否正常 | 运行 `simulate_new_eeg_data.skills` 生成完美数据，再跑主力引擎（应得到 ~99%） |\n| 需要导出当前状态存档 | 运行 `_export_md.skills` 生成 Markdown 快照 |\n')

# ============================================================
#  6. 交互式主菜单
# ============================================================
def show_menu():
    while True:
        print("\n" + "="*50)
        print(" 🧠 EEG-Expert 智能专家系统 (V9.5 Lite)")
        print("="*50)
        print("  1. [Analyze] 启动高精诊断引擎 (V9.2)")
        print("  2. [Import]  导入外部 CSV 数据")
        print("  3. [Inspect] 巡检数据库状态")
        print("  4. [Route A] 运行神经机制分析手册")
        print("  q. 退出系统")
        print("-" * 50)
        
        choice = input(" 请选择功能 (1-4): ").strip().lower()
        if choice == '1': run_analyze()
        elif choice == '2': 
            path = input(" 请输入 CSV 路径: ").strip()
            table = input(" 目标表名 (回车默认 kaggle_eeg): ").strip() or None
            run_import(path, table)
        elif choice == '3': run_inspect()
        elif choice == '4': run_route_a_neurora()
        elif choice == 'q': break
        else: print("  ⚠️ 无效选择，请重新输入。")

# ============================================================
#  7. 入口解析
# ============================================================
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="EEG-Expert Master System")
    subparsers = parser.add_subparsers(dest="command")
    
    subparsers.add_parser("analyze").add_argument("--table", help="指定分析表名")
    import_p = subparsers.add_parser("import")
    import_p.add_argument("path", help="CSV文件路径")
    import_p.add_argument("--table", help="目标表名")
    subparsers.add_parser("inspect").add_argument("--table", help="指定巡检表名")
    subparsers.add_parser("route_a").add_argument("--table", help="指定分析表名")
    
    args = parser.parse_args()
    
    if args.command == "analyze": run_analyze(args.table)
    elif args.command == "import": run_import(args.path, args.table)
    elif args.command == "inspect": run_inspect(args.table)
    elif args.command == "route_a": run_route_a_neurora(args.table)
    else: show_menu()
